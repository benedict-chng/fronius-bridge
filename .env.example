# fronius-bridge configuration — copy to .env and edit.
# python-dotenv loads this file at startup; real environment variables
# still take precedence.

# Fronius inverter IP on the home LAN
FRONIUS_HOST=192.168.68.x

# home-energy-server solar ingest endpoint
INGEST_URL=http://192.168.68.141:8000/api/v1/solar/readings

# The server's ingest API key (home-energy-server .env: INGEST_API_KEY)
# NOTE: placeholder! Copying .env.example without replacing this caused
# a 401 debugging session on the Powerpal side — don't skip it.
INGEST_API_KEY=PASTE_INGEST_API_KEY_HERE

# Polling cadence in seconds
POLL_SECONDS=60
